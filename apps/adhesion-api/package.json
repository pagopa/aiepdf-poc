{
  "name": "adhesion-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/adhesion-api/dist",
          "format": [
            "esm"
          ],
          "bundle": true,
          "main": "apps/adhesion-api/src/main.ts",
          "tsConfig": "apps/adhesion-api/tsconfig.app.json",
          "external": [
            "pg-native"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {
            "esbuildOptions": {
              "sourcemap": true
            }
          },
          "production": {
            "esbuildOptions": {
              "sourcemap": false
            }
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "adhesion-api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "adhesion-api:build:development"
          },
          "production": {
            "buildTarget": "adhesion-api:build:production"
          }
        }
      },
      "docker:build": {
        "dependsOn": [
          "build",
          "prune"
        ]
      },
      "test:integration": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/adhesion-api",
          "command": "vitest run --config vitest.integration.config.mts"
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/adhesion-api/dist/package.json",
          "{workspaceRoot}/apps/adhesion-api/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/adhesion-api/dist/pnpm-workspace.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/adhesion-api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      }
    },
    "tags": [
      "scope:adhesion",
      "type:app"
    ]
  },
  "dependencies": {
    "@aiepdf/adhesion-contracts": "workspace:*",
    "@aiepdf/adhesion-domain": "workspace:*",
    "@aiepdf/adhesion-verification": "workspace:*",
    "@azure/app-configuration-provider": "^2.6.0",
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.33.0",
    "@fastify/autoload": "^6.0.3",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/sensible": "^6.0.5",
    "@microsoft/feature-management": "^2.3.1",
    "@pagopa/azure-tracing": "^0.5.8",
    "asn1js": "^3.0.10",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.23.0",
    "pkijs": "^3.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/azurite": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.15.6",
    "testcontainers": "^12.1.0"
  }
}
