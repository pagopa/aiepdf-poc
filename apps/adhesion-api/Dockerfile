# This file is generated by Nx and customised for the adhesion-api image.
#
# Build the docker image with `npx nx docker:build adhesion-api`.
# Build context: `apps/adhesion-api` (the Nx pruned output must exist first:
# `npx nx run adhesion-api:prune`).
#
# Run the container with `nx docker:run adhesion-api -p 3000:3000`.

FROM docker.io/node:lts-alpine

ENV HOST=0.0.0.0
ENV PORT=3000

# Pin the pnpm version to the repository one instead of letting Corepack pick
# the latest major, whose supply-chain defaults reject the freshly generated
# pruned lockfile.
RUN corepack enable && corepack prepare pnpm@10.34.5 --activate


WORKDIR /app

COPY dist .

# Installs the external (non-bundled) runtime dependencies declared by the
# pruned package.json. The workspace code itself is bundled into main.js.
RUN pnpm install

CMD [ "node", "main.js" ]
