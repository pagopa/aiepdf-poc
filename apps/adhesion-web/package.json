{
  "name": "adhesion-web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "sourceRoot": "apps/adhesion-web/src",
    "tags": [
      "scope:adhesion",
      "type:app"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "^default",
          {
            "env": "NEXT_PUBLIC_API_BASE_URL"
          }
        ],
        "outputs": [
          "{projectRoot}/out",
          "{projectRoot}/.next/!(cache)"
        ]
      }
    }
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.16.0",
    "@mui/material": "^5.16.0",
    "@mui/material-nextjs": "^5.16.0",
    "@mui/system": "^5.16.0",
    "@pagopa/mui-italia": "2.7.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "14.2.35",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^27.1.0"
  }
}
