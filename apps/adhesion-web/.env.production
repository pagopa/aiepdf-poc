# Public API endpoint of the dev pilot.
#
# The DX static web app pipeline builds the workspace without extra build
# arguments, so the dev value lives here. Next.js inlines `NEXT_PUBLIC_*`
# variables at build time; set the real environment variable in the build
# environment to override it when the same workspace is deployed elsewhere.
#
# Update this when the Container App is recreated with a new FQDN (the smoke
# test checks that the deployed bundle embeds the expected API base URL).
NEXT_PUBLIC_API_BASE_URL=https://dx-d-itn-aiepdf-adhesion-ca-01.braveground-bb3003fe.italynorth.azurecontainerapps.io
